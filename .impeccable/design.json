  "narrative": {
    "northStar": "Quiet Signal",
    "overview": "A portfolio you navigate. One dark ground and one shell across the main site and the blog. The matrix motif is a source field made of the page's own words: dim, lit by slow streams, legible under the pointer. The home page's moment is a site map of everything as one graph, and a command palette reaches any page.",
    "keyCharacteristics": [
      "One ground, one shell, one accent across main site and blog.",
      "Sans for reading; mono for labels, navigation, metadata, and data.",
      "Tonal steps and 1px lines instead of glow.",
      "Source field: the matrix motif built from real content.",
      "Site map and command palette as primary navigation."
    ],
    "rules": [
      {
        "name": "The Live Signal Rule",
        "body": "Green marks state or action. One filled primary per area.",
        "section": "colors"
      },
      {
        "name": "The No-Glow Rule",
        "body": "No neon halos, animated borders, scan lines, grids, or scroll reveals.",
        "section": "elevation"
      },
      {
        "name": "The Path Rule",
        "body": "A mono location path replaces kickers above titles.",
        "section": "typography"
      },
      {
        "name": "The Real Text Rule",
        "body": "Decode is drawn on aria-hidden overlays; real text never changes.",
        "section": "motion"
      },
      {
        "name": "The Never-Wait Rule",
        "body": "Every animated step has a time limit so navigation always completes.",
        "section": "motion"
      },
      {
        "name": "The Frequency Rule",
        "body": "Keyboard-opened UI appears instantly; frequent interactions never decode.",
        "section": "motion"
      }
    ],
    "dos": [
      "Do keep one ground and one shell on every page, articles included.",
      "Do give every graph an equivalent list or text path.",
      "Do gate pointer effects behind fine pointers and give touch tap-to-select."
    ],
    "donts": [
      "Don't reintroduce light grounds for articles; use the data hues.",
      "Don't decorate with random glyphs; the motif is the site's own words.",
      "Don't hijack the scroll wheel; zoom needs a modifier.",
      "Don't put a kicker above a heading or set prose in mono."
    ]
  }
}